# Measurement data is committed as plain .csv (see README §3).
# Never commit compressed copies.
*.csv.gz
*.zip

# Parquet cache built by qpviz.loader
.cache/
*.parquet

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Satellite TLE snapshots (downloaded / archived, not committed)
TLE/*.tle
TLE/*.txt
!TLE/README.md

# Local agent / tooling directories
.agents/
.claude/

# Streamlit secrets (CARTO_API_KEY etc.) — never commit
.streamlit/secrets.toml
