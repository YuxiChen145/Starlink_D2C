# Measurement data: raw CSVs stay local (large); the gzipped copies (*.csv.gz)
# are committed so a plain clone / cloud deploy has data. The loader reads either.
*.csv

# Parquet cache built by qpviz.loader
.cache/
*.parquet

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Satellite TLE snapshots (downloaded / archived, not committed)
TLE/*.tle
TLE/*.txt
!TLE/README.md

# Local agent / tooling directories
.agents/
.claude/
