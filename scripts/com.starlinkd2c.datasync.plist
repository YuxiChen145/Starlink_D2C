<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.starlinkd2c.datasync</string>

  <!-- Run sync.sh whenever the data folders change. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/yuxichen/Documents/GitHub/Starlink_D2C/sync.sh</string>
  </array>

  <key>WatchPaths</key>
  <array>
    <string>/Users/yuxichen/Documents/GitHub/Starlink_D2C/QP CSV</string>
    <string>/Users/yuxichen/Documents/GitHub/Starlink_D2C/PRISM CSV</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yuxichen/Documents/GitHub/Starlink_D2C</string>

  <!-- Give git your login + PATH; adjust if your git lives elsewhere. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/starlinkd2c-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/starlinkd2c-sync.log</string>
</dict>
</plist>
